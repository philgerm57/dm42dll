<Project Sdk="Microsoft.NET.Sdk">
  <!-- Validation de dm42dll : dotnet run (compiler d'abord dm42dll en Debug) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="dm42dll"><HintPath>..\..\bin\Debug\dm42dll.dll</HintPath></Reference>
  </ItemGroup>
</Project>
